{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate",
    "status",
    "owner",
    "independent_reviewer",
    "evidence_sha256",
    "approved_at"
  ],
  "properties": {
    "gate": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5_TECH",
        "G5_BUSINESS"
      ]
    },
    "status": {
      "enum": [
        "APPROVED",
        "BLOCK"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "independent_reviewer": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
